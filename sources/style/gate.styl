.gate
    position fixed
    inset 0
    z-index 100
    display flex
    flex-direction column
    background #0f1424
    color #ffffff
    font-family 'Nunito', system-ui, sans-serif
    transition opacity 0.5s, visibility 0.5s

    html.is-gate-done &
        opacity 0
        visibility hidden
        pointer-events none

    .gate-head
        flex none
        padding 22px clamp(20px, 4vw, 56px) 18px

    .gate-name
        margin 0
        font-size clamp(34px, 6vw, 72px)
        font-weight 900
        line-height 1
        letter-spacing -0.03em

    .gate-course
        margin 10px 0 0
        font-size clamp(13px, 1.6vw, 17px)
        line-height 1.45
        opacity 0.75

    .gate-split
        flex 1
        display flex
        min-height 0

        @media (max-width: 700px)
            flex-direction column

    .gate-pane
        position relative
        flex 1
        display flex
        flex-direction column
        justify-content flex-end
        gap 10px
        padding clamp(20px, 4vw, 56px)
        border 0
        border-radius 0
        text-align left
        font inherit
        text-decoration none
        cursor pointer
        overflow hidden
        transition flex-grow 0.45s cubic-bezier(0.2, 0.8, 0.2, 1)

        &:hover, &:focus-visible
            flex-grow 1.35

        &:focus-visible
            outline 4px solid #c8f05a
            outline-offset -4px

    .gate-word
        font-size clamp(64px, 13vw, 170px)
        font-weight 900
        line-height 0.9
        letter-spacing -0.05em

    .gate-desc
        max-width 30ch
        font-size clamp(15px, 1.7vw, 19px)
        line-height 1.45

    .gate-meta
        font-size 13px
        font-weight 700
        opacity 0.7

    .gate-read
        background #e9edf2
        color #101a2e
        background-image repeating-linear-gradient(180deg, transparent 0 35px, rgba(16, 26, 46, 0.08) 35px 36px)

    .gate-drive
        color #ffffff
        background linear-gradient(165deg, #3a1458 0%, #c2417a 58%, #f08a3c 100%)

        // a dashed road drifting past
        &::before
            content ''
            position absolute
            left -10%
            right -10%
            top 36%
            height 6px
            transform rotate(-8deg)
            background repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.55) 0 38px, transparent 38px 76px)
            animation gate-road 2.4s linear infinite

    .gate-progress
        flex none
        height 4px
        background #1c2440
        opacity 0
        transition opacity 0.2s

    .gate-bar
        width 35%
        height 100%
        background #c8f05a
        animation gate-slide 1.1s ease-in-out infinite

    &.is-loading .gate-progress
        opacity 1

    &.is-error .gate-drive .gate-meta::after
        content ', failed to load, tap to retry'

@keyframes gate-road
    to
        background-position 76px 0

@media (prefers-reduced-motion: reduce)
    .gate .gate-drive::before, .gate .gate-bar
        animation none

@keyframes gate-slide
    0%
        transform translateX(-100%)
    100%
        transform translateX(300%)

// Tutorial
.tutorial
    position fixed
    inset 0
    z-index 60
    display flex
    align-items center
    justify-content center
    padding 20px
    background rgba(17, 17, 15, 0.72)
    font-family 'Nunito', system-ui, sans-serif

    &[hidden]
        display none

    .tutorial-card
        width 100%
        max-width 460px
        padding 26px
        background #11110f
        color #e9e6dc
        border 1px solid #34342d
        box-shadow 0 20px 60px rgba(0, 0, 0, 0.5)

        h2
            margin 0 0 16px
            font-size 26px
            font-weight 900
            color #c8f05a

    .tutorial-list
        margin 0
        padding 0
        list-style none

        li
            display grid
            grid-template-columns 110px 1fr
            gap 10px
            padding 9px 0
            border-bottom 1px solid #2a2a24
            font-size 15px

        b
            font-weight 900

    .tutorial-hint
        margin 16px 0 20px
        font-size 13px
        line-height 1.5
        opacity 0.7

    .tutorial-button
        width 100%
        padding 14px
        font inherit
        font-weight 900
        font-size 16px
        color #11110f
        background #c8f05a
        border 0
        cursor pointer

        &:focus-visible
            outline 3px solid #e9e6dc
            outline-offset 2px

    .t-touch
        display none

    html.is-mode-touch & .t-touch
        display inline

    html.is-mode-touch & .t-desk
        display none

// Minimap
.minimap
    position fixed
    left 12px
    top 12px
    --minimap-radius 85px
    z-index 8
    width 170px
    height 170px
    overflow hidden
    border-radius 50%
    border 4px solid #e9e6dc
    box-shadow 0 0 0 3px #11110f, 0 0 0 5px #c8f05a, 0 8px 24px rgba(0, 0, 0, 0.5)
    background #1b1b17
    pointer-events none
    display none

    html.is-started.is-gate-done:not(.input-filter-intro):not(.input-filter-menu):not(.input-filter-modal) &
        display block

    @media (max-width: 700px)
        width 124px
        height 124px
        --minimap-radius 62px
        left 8px
        top 8px

    .minimap-map
        position absolute
        left 0
        top 0
        width 600px
        height 600px
        background-size 100% 100%
        background-repeat no-repeat
        will-change transform
        transform-origin 0 0

    &::after
        content ''
        position absolute
        inset 0
        border-radius 50%
        box-shadow inset 0 0 22px 6px rgba(17, 17, 15, 0.55)
        pointer-events none

    .minimap-player
        z-index 2
        position absolute
        left 50%
        top 50%
        width 0
        height 0
        margin-left -7px
        margin-top -9px
        border-left 7px solid transparent
        border-right 7px solid transparent
        border-bottom 18px solid #ef4e35
        transform-origin 7px 9px
        filter drop-shadow(0 1px 1px rgba(0, 0, 0, 0.6))

.skills-counter
    position fixed
    left 12px
    top 170px
    z-index 8
    padding 5px 12px
    font-family 'Nunito', system-ui, sans-serif
    font-size 13px
    font-weight 900
    color #11110f
    background #c8f05a
    pointer-events none
    display none

    html.is-started.is-gate-done:not(.input-filter-intro):not(.input-filter-menu):not(.input-filter-modal) &
        display block

    @media (max-width: 700px)
        left 8px
        top 146px

.minimap-arrow
    position absolute
    left 50%
    top 50%
    width 0
    height 0
    margin-left -8px
    margin-top -10px
    border-left 8px solid transparent
    border-right 8px solid transparent
    border-bottom 20px solid #c8f05a
    filter drop-shadow(0 0 3px #11110f)
    display none

.minimap-dot
    position absolute
    width 8px
    height 8px
    margin -4px 0 0 -4px
    border-radius 50%
    background #c8f05a
    border 2px solid #11110f
    opacity 0.6

    &.is-current
        width 16px
        height 16px
        margin -8px 0 0 -8px
        opacity 1
        box-shadow 0 0 0 4px rgba(200, 240, 90, 0.35)
        animation dot-pulse 1.1s ease-in-out infinite

.minimap-route
    position absolute
    left 0
    top 0
    width 600px
    height 600px
    overflow visible

    .route-all
        fill none
        stroke #c8f05a
        stroke-width 3
        stroke-dasharray 8 8
        opacity 0.45

    .route-now
        stroke #c8f05a
        stroke-width 6
        stroke-linecap round
        filter drop-shadow(0 0 3px #11110f)

@keyframes dot-pulse
    50%
        box-shadow 0 0 0 9px rgba(200, 240, 90, 0)

.skill-hud
    position fixed
    left 12px
    top 196px
    white-space nowrap
    z-index 8
    padding 5px 12px
    font 900 13px 'Nunito', system-ui, sans-serif
    color #11110f
    background #c8f05a
    border-radius 12px
    pointer-events none
    display none

    @media (max-width: 700px)
        left 8px
        top 146px
        font-size 12px

    html.is-started.is-gate-done:not(.input-filter-intro):not(.input-filter-menu):not(.input-filter-modal) &
        display block

.minimap-compass
    position absolute
    inset 0
    z-index 3
    pointer-events none

    span
        position absolute
        left 50%
        top 3px
        margin-left -8px
        width 16px
        height 16px
        line-height 16px
        text-align center
        font 900 11px 'Nunito', system-ui, sans-serif
        color #11110f
        background #e9e6dc
        border-radius 50%

// Go button and panel
.go-button
    position fixed
    right 12px
    top 142px
    z-index 8
    min-width 52px
    padding 0 14px
    height 40px
    font 900 15px 'Nunito', system-ui, sans-serif
    color #11110f
    background #c8f05a
    border 0
    cursor pointer
    display none

    &:focus-visible
        outline 3px solid #e9e6dc

    html.is-started.is-gate-done:not(.input-filter-intro):not(.input-filter-menu):not(.input-filter-modal) &
        display block

.go-panel
    position fixed
    inset 0
    z-index 70
    display flex
    align-items flex-end
    justify-content center
    padding 12px
    background rgba(17, 17, 15, 0.55)
    font-family 'Nunito', system-ui, sans-serif

    &[hidden]
        display none

    @media (min-width: 700px)
        align-items center

.go-card
    width 100%
    max-width 460px
    max-height 88vh
    overflow auto
    padding 18px
    background #11110f
    color #e9e6dc
    border 1px solid #34342d
    box-shadow 0 20px 60px rgba(0, 0, 0, 0.5)

    .go-head
        display flex
        align-items center
        justify-content space-between

        h2
            margin 0
            font-size 24px
            font-weight 900
            color #c8f05a

    .go-close
        width 36px
        height 36px
        font-size 24px
        color #e9e6dc
        background transparent
        border 1px solid #34342d
        cursor pointer

    .go-hunt
        display flex
        align-items center
        justify-content space-between
        gap 12px
        margin 14px 0
        padding 12px
        background #1b1b17
        border 1px solid #c8f05a

        strong
            display block
            font-size 16px

        .go-hunt-text
            font-size 12px
            opacity 0.7

    .go-hunt-button
        flex none
        padding 10px 12px
        font 900 13px 'Nunito', system-ui, sans-serif
        color #11110f
        background #c8f05a
        border 0
        cursor pointer

        &[disabled]
            opacity 0.4

    .go-label
        margin 6px 0
        font-size 11px
        font-weight 900
        letter-spacing 0.12em
        text-transform uppercase
        opacity 0.6

    .go-places
        display grid
        gap 8px

    .go-place
        display grid
        grid-template-columns 1fr auto
        gap 2px 10px
        padding 12px
        text-align left
        font inherit
        color inherit
        background #1b1b17
        border 1px solid #2a2a24
        cursor pointer

        &:hover, &:focus-visible
            border-color #c8f05a
            outline none

        .go-place-name
            font-weight 900
            font-size 15px

        .go-place-distance
            grid-row 1 / span 2
            grid-column 2
            align-self center
            font-weight 900
            color #c8f05a

        .go-place-blurb
            font-size 12px
            opacity 0.65

    .go-clear
        width 100%
        margin-top 12px
        padding 10px
        font 700 13px 'Nunito', system-ui, sans-serif
        color #e9e6dc
        background transparent
        border 1px solid #34342d
        cursor pointer

// Area banner
.area-banner
    position fixed
    top 14px
    left 50%
    z-index 9
    width calc(100% - 340px)
    max-width 460px
    padding 12px 16px
    transform translate(-50%, -140%)
    opacity 0
    pointer-events none
    transition transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1), opacity 0.4s
    background rgba(17, 17, 15, 0.92)
    color #e9e6dc
    border-left 5px solid #c8f05a
    font-family 'Nunito', system-ui, sans-serif
    display none

    html.is-started.is-gate-done:not(.input-filter-intro):not(.input-filter-menu):not(.input-filter-modal) &
        display block

    &.is-visible
        transform translate(-50%, 0)
        opacity 1

    .area-name
        display block
        font-size 20px
        font-weight 900
        color #c8f05a

    .area-text
        display block
        margin-top 2px
        font-size 13px
        line-height 1.4
        opacity 0.85

    @media (max-width: 700px)
        top auto
        bottom 96px
        width calc(100% - 24px)
        padding 10px 12px

        .area-name
            font-size 17px

        .area-text
            font-size 12px

// Map labels are always visible
.map .location .name
    transform scale(1, 1) !important

    @media (max-width: 700px)
        transform scale(0.7, 0.7) !important
