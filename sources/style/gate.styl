.gate
    --ink #0f1424
    --paper #f6f7fb
    --line #d9deea
    --muted #56607a
    --accent #c2417a
    position fixed
    inset 0
    z-index 100
    overflow-y auto
    scroll-behavior smooth
    scroll-padding-top 84px
    background var(--paper)
    color var(--ink)
    font-family 'Nunito', system-ui, sans-serif
    line-height 1.55
    transition opacity 0.5s, visibility 0.5s

    html.is-gate-done &
        opacity 0
        visibility hidden
        pointer-events none

    a
        color var(--accent)

    .gate-bar-top
        position sticky
        top 0
        z-index 2
        display flex
        flex-wrap wrap
        align-items center
        justify-content space-between
        gap 10px
        padding 12px clamp(16px, 4vw, 48px)
        background rgba(246, 247, 251, 0.94)
        border-bottom 1px solid var(--line)

    .gate-brand
        color var(--ink)
        text-decoration none
        font-size 18px

        span
            margin-left 8px
            padding 2px 8px
            font-weight 900
            font-size 14px
            color #fff
            background var(--ink)

    .gate-actions
        display flex
        flex-wrap wrap
        gap 10px

    .gate-btn
        display inline-flex
        flex-direction column
        align-items center
        justify-content center
        padding 10px 18px
        font 900 15px 'Nunito', system-ui, sans-serif
        text-decoration none
        border 2px solid var(--ink)
        cursor pointer
        color var(--ink)
        background transparent

        small
            font-size 11px
            font-weight 700
            opacity 0.85

        &:focus-visible
            outline 3px solid var(--accent)
            outline-offset 2px

    .gate-btn-solid
        color #fff
        background var(--ink)

    .gate-btn-drive
        position relative
        overflow hidden
        color #fff
        border-color transparent
        background linear-gradient(165deg, #3a1458 0%, #c2417a 58%, #f08a3c 100%)

        &::before
            content ''
            position absolute
            left -10%
            right -10%
            top 50%
            height 3px
            transform rotate(-8deg)
            background repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.35) 0 20px, transparent 20px 40px)
            animation gate-road 2.4s linear infinite

    .gate-progress
        position absolute
        left 0
        right 0
        bottom -1px
        height 4px
        background transparent
        opacity 0
        transition opacity 0.2s

    .gate-bar
        width 35%
        height 100%
        background var(--accent)
        animation gate-slide 1.1s ease-in-out infinite

    &.is-loading .gate-progress
        opacity 1

    &.is-error .gate-btn-drive small::after
        content ', failed, tap to retry'

    .gate-page
        max-width 960px
        margin 0 auto
        padding 32px clamp(16px, 4vw, 48px) 80px

    .g-hero
        display grid
        grid-template-columns 240px 1fr
        gap 32px
        align-items start

        @media (max-width: 700px)
            grid-template-columns 1fr

        h1
            margin 0
            font-size clamp(40px, 7vw, 76px)
            font-weight 900
            line-height 1
            letter-spacing -0.03em

    .g-photo
        position relative
        width 240px
        max-width 100%
        aspect-ratio 4 / 5
        background linear-gradient(165deg, #3a1458, #c2417a 58%, #f08a3c)
        overflow hidden

        img
            position relative
            z-index 1
            width 100%
            height 100%
            object-fit cover

        span
            position absolute
            inset 0
            display flex
            align-items center
            justify-content center
            font-size 72px
            font-weight 900
            color #fff

    .g-sub
        margin 8px 0 18px
        font-size clamp(16px, 2vw, 20px)
        color var(--muted)

    .g-id
        display grid
        gap 6px
        margin 0 0 18px
        padding 14px 16px
        background #fff
        border 1px solid var(--line)

        div
            display grid
            grid-template-columns 110px 1fr
            gap 8px

        dt
            color var(--muted)
            font-size 14px

        dd
            margin 0
            overflow-wrap anywhere

        b
            font-size 18px

    .g-about
        max-width 62ch
        margin 0 0 14px

    .g-jump
        display flex
        flex-wrap wrap
        gap 8px 18px
        margin 0
        font-weight 700

    .g-stats
        display grid
        grid-template-columns repeat(4, 1fr)
        gap 1px
        margin 36px 0
        background var(--line)
        border 1px solid var(--line)

        @media (max-width: 700px)
            grid-template-columns repeat(2, 1fr)

        div
            padding 16px
            background #fff

        b
            display block
            font-size 34px
            font-weight 900
            line-height 1.1
            color var(--accent)

        span
            font-size 13px
            color var(--muted)

    .g-sec
        padding-top 28px
        border-top 1px solid var(--line)
        margin-top 28px

        h2
            margin 0 0 12px
            font-size clamp(24px, 3.4vw, 32px)
            font-weight 900
            letter-spacing -0.02em

        p
            max-width 68ch

    .g-team
        display grid
        grid-template-columns repeat(auto-fill, minmax(260px, 1fr))
        gap 8px
        margin 14px 0
        padding 0
        list-style none

        li
            padding 10px 12px
            background #fff
            border 1px solid var(--line)

        b
            margin-right 8px
            font-size 17px

        em
            display inline-block
            margin-left 6px
            padding 1px 8px
            font-size 12px
            font-style normal
            font-weight 800
            color #fff
            background var(--accent)

    .g-list
        padding-left 20px

        li
            margin 6px 0
            max-width 70ch

    .g-rows
        padding 0
        list-style none

        li
            display grid
            grid-template-columns 1fr 1fr
            gap 0 16px
            padding 12px 0
            border-bottom 1px solid var(--line)

            @media (max-width: 700px)
                grid-template-columns 1fr

        span
            color var(--muted)
            font-size 14px

        p
            grid-column 1 / -1
            margin 4px 0 0

    .g-fine
        font-size 13px
        color var(--muted)

@keyframes gate-road
    to
        background-position 76px 0

@media (prefers-reduced-motion: reduce)
    .gate .gate-drive::before, .gate .gate-bar
        animation none

@keyframes gate-slide
    0%
        transform translateX(-100%)
    100%
        transform translateX(300%)

// Tutorial
.tutorial
    position fixed
    inset 0
    z-index 60
    display flex
    align-items center
    justify-content center
    padding 20px
    background rgba(17, 17, 15, 0.72)
    font-family 'Nunito', system-ui, sans-serif

    &[hidden]
        display none

    .tutorial-card
        width 100%
        max-width 460px
        padding 26px
        background #11110f
        color #e9e6dc
        border 1px solid #34342d
        box-shadow 0 20px 60px rgba(0, 0, 0, 0.5)

        h2
            margin 0 0 16px
            font-size 26px
            font-weight 900
            color #c8f05a

    .tutorial-list
        margin 0
        padding 0
        list-style none

        li
            display grid
            grid-template-columns 110px 1fr
            gap 10px
            padding 9px 0
            border-bottom 1px solid #2a2a24
            font-size 15px

        b
            font-weight 900

    .tutorial-hint
        margin 16px 0 20px
        font-size 13px
        line-height 1.5
        opacity 0.7

    .tutorial-button
        width 100%
        padding 14px
        font inherit
        font-weight 900
        font-size 16px
        color #11110f
        background #c8f05a
        border 0
        cursor pointer

        &:focus-visible
            outline 3px solid #e9e6dc
            outline-offset 2px

    .t-touch
        display none

    html.is-mode-touch & .t-touch
        display inline

    html.is-mode-touch & .t-desk
        display none

// Minimap
.minimap
    position fixed
    left 12px
    top 12px
    --minimap-radius 85px
    z-index 8
    width 170px
    height 170px
    overflow hidden
    border-radius 50%
    border 4px solid #e9e6dc
    box-shadow 0 0 0 3px #11110f, 0 0 0 5px #c8f05a, 0 8px 24px rgba(0, 0, 0, 0.5)
    background #1b1b17
    pointer-events none
    display none

    html.is-started.is-gate-done:not(.input-filter-intro):not(.input-filter-menu):not(.input-filter-modal) &
        display block

    @media (max-width: 700px)
        width 124px
        height 124px
        --minimap-radius 62px
        left 8px
        top 8px

    .minimap-map
        position absolute
        left 0
        top 0
        width 600px
        height 600px
        background-size 100% 100%
        background-repeat no-repeat
        will-change transform
        transform-origin 0 0

    &::after
        content ''
        position absolute
        inset 0
        border-radius 50%
        box-shadow inset 0 0 22px 6px rgba(17, 17, 15, 0.55)
        pointer-events none

    .minimap-player
        z-index 2
        position absolute
        left 50%
        top 50%
        width 0
        height 0
        margin-left -7px
        margin-top -9px
        border-left 7px solid transparent
        border-right 7px solid transparent
        border-bottom 18px solid #ef4e35
        transform-origin 7px 9px
        filter drop-shadow(0 1px 1px rgba(0, 0, 0, 0.6))

.skills-counter
    position fixed
    left 12px
    top 170px
    z-index 8
    padding 5px 12px
    font-family 'Nunito', system-ui, sans-serif
    font-size 13px
    font-weight 900
    color #11110f
    background #c8f05a
    pointer-events none
    display none

    html.is-started.is-gate-done:not(.input-filter-intro):not(.input-filter-menu):not(.input-filter-modal) &
        display block

    @media (max-width: 700px)
        left 8px
        top 146px

.minimap-arrow
    position absolute
    left 50%
    top 50%
    width 0
    height 0
    margin-left -8px
    margin-top -10px
    border-left 8px solid transparent
    border-right 8px solid transparent
    border-bottom 20px solid #c8f05a
    filter drop-shadow(0 0 3px #11110f)
    display none

.minimap-dot
    position absolute
    width 8px
    height 8px
    margin -4px 0 0 -4px
    border-radius 50%
    background #c8f05a
    border 2px solid #11110f
    opacity 0.6

    &.is-current
        width 16px
        height 16px
        margin -8px 0 0 -8px
        opacity 1
        box-shadow 0 0 0 4px rgba(200, 240, 90, 0.35)
        animation dot-pulse 1.1s ease-in-out infinite

.minimap-route
    position absolute
    left 0
    top 0
    width 600px
    height 600px
    overflow visible

    .route-all
        fill none
        stroke #c8f05a
        stroke-width 3
        stroke-dasharray 8 8
        opacity 0.45

    .route-now
        stroke #c8f05a
        stroke-width 6
        stroke-linecap round
        filter drop-shadow(0 0 3px #11110f)

@keyframes dot-pulse
    50%
        box-shadow 0 0 0 9px rgba(200, 240, 90, 0)

.skill-hud
    position fixed
    left 12px
    top 196px
    white-space nowrap
    z-index 8
    padding 5px 12px
    font 900 13px 'Nunito', system-ui, sans-serif
    color #11110f
    background #c8f05a
    border-radius 12px
    pointer-events none
    display none

    @media (max-width: 700px)
        left 8px
        top 146px
        font-size 12px

    html.is-started.is-gate-done:not(.input-filter-intro):not(.input-filter-menu):not(.input-filter-modal) &
        display block

.minimap-compass
    position absolute
    inset 0
    z-index 3
    pointer-events none

    span
        position absolute
        left 50%
        top 3px
        margin-left -8px
        width 16px
        height 16px
        line-height 16px
        text-align center
        font 900 11px 'Nunito', system-ui, sans-serif
        color #11110f
        background #e9e6dc
        border-radius 50%

// Go button and panel
.go-button
    position fixed
    right 12px
    top 142px
    z-index 8
    min-width 52px
    padding 0 14px
    height 40px
    font 900 15px 'Nunito', system-ui, sans-serif
    color #11110f
    background #c8f05a
    border 0
    cursor pointer
    display none

    &:focus-visible
        outline 3px solid #e9e6dc

    html.is-started.is-gate-done:not(.input-filter-intro):not(.input-filter-menu):not(.input-filter-modal) &
        display block

.go-panel
    position fixed
    inset 0
    z-index 70
    display flex
    align-items flex-end
    justify-content center
    padding 12px
    background rgba(17, 17, 15, 0.55)
    font-family 'Nunito', system-ui, sans-serif

    &[hidden]
        display none

    @media (min-width: 700px)
        align-items center

.go-card
    width 100%
    max-width 460px
    max-height 88vh
    overflow auto
    padding 18px
    background #11110f
    color #e9e6dc
    border 1px solid #34342d
    box-shadow 0 20px 60px rgba(0, 0, 0, 0.5)

    .go-head
        display flex
        align-items center
        justify-content space-between

        h2
            margin 0
            font-size 24px
            font-weight 900
            color #c8f05a

    .go-close
        width 36px
        height 36px
        font-size 24px
        color #e9e6dc
        background transparent
        border 1px solid #34342d
        cursor pointer

    .go-hunt
        display flex
        align-items center
        justify-content space-between
        gap 12px
        margin 14px 0
        padding 12px
        background #1b1b17
        border 1px solid #c8f05a

        strong
            display block
            font-size 16px

        .go-hunt-text
            font-size 12px
            opacity 0.7

    .go-hunt-button
        flex none
        padding 10px 12px
        font 900 13px 'Nunito', system-ui, sans-serif
        color #11110f
        background #c8f05a
        border 0
        cursor pointer

        &[disabled]
            opacity 0.4

    .go-label
        margin 6px 0
        font-size 11px
        font-weight 900
        letter-spacing 0.12em
        text-transform uppercase
        opacity 0.6

    .go-places
        display grid
        gap 8px

    .go-place
        display grid
        grid-template-columns 1fr auto
        gap 2px 10px
        padding 12px
        text-align left
        font inherit
        color inherit
        background #1b1b17
        border 1px solid #2a2a24
        cursor pointer

        &:hover, &:focus-visible
            border-color #c8f05a
            outline none

        .go-place-name
            font-weight 900
            font-size 15px

        .go-place-distance
            grid-row 1 / span 2
            grid-column 2
            align-self center
            font-weight 900
            color #c8f05a

        .go-place-blurb
            font-size 12px
            opacity 0.65

    .go-clear
        width 100%
        margin-top 12px
        padding 10px
        font 700 13px 'Nunito', system-ui, sans-serif
        color #e9e6dc
        background transparent
        border 1px solid #34342d
        cursor pointer

// Area banner
.area-banner
    position fixed
    top 14px
    left 50%
    z-index 9
    width calc(100% - 340px)
    max-width 460px
    padding 12px 16px
    transform translate(-50%, -140%)
    opacity 0
    pointer-events none
    transition transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1), opacity 0.4s
    background rgba(17, 17, 15, 0.92)
    color #e9e6dc
    border-left 5px solid #c8f05a
    font-family 'Nunito', system-ui, sans-serif
    display none

    html.is-started.is-gate-done:not(.input-filter-intro):not(.input-filter-menu):not(.input-filter-modal) &
        display block

    &.is-visible
        transform translate(-50%, 0)
        opacity 1

    .area-name
        display block
        font-size 20px
        font-weight 900
        color #c8f05a

    .area-text
        display block
        margin-top 2px
        font-size 13px
        line-height 1.4
        opacity 0.85

    @media (max-width: 700px)
        top auto
        bottom 96px
        width calc(100% - 24px)
        padding 10px 12px

        .area-name
            font-size 17px

        .area-text
            font-size 12px

// Map labels are always visible
.map .location .name
    transform scale(1, 1) !important

    @media (max-width: 700px)
        transform scale(0.7, 0.7) !important
