.gate
    position fixed
    inset 0
    z-index 100
    display flex
    align-items center
    justify-content center
    padding 24px
    background #11110f
    color #e9e6dc
    font-family 'Nunito', system-ui, sans-serif
    transition opacity 0.5s, visibility 0.5s

    html.is-gate-done &
        opacity 0
        visibility hidden
        pointer-events none

    .gate-inner
        width 100%
        max-width 760px

    .gate-tag
        display inline-flex
        align-items center
        gap 10px
        font-weight 900
        letter-spacing 0.18em
        font-size 13px
        color #c8f05a

    .gate-dot
        width 12px
        height 12px
        background #ef4e35

    .gate-title
        margin 18px 0 28px
        font-size clamp(30px, 6vw, 52px)
        line-height 1.05
        font-weight 900

    .gate-options
        display grid
        grid-template-columns 1fr 1fr
        gap 14px

        @media (max-width: 620px)
            grid-template-columns 1fr

    .gate-card
        display flex
        flex-direction column
        gap 8px
        padding 22px
        text-align left
        text-decoration none
        color inherit
        font inherit
        background #1b1b17
        border 1px solid #34342d
        cursor pointer
        transition transform 0.15s, border-color 0.15s, background 0.15s

        &:hover:not([disabled])
            transform translateY(-3px)
            border-color #c8f05a

        &:focus-visible
            outline 3px solid #c8f05a
            outline-offset 3px

    .gate-card-primary
        background #c8f05a
        color #11110f
        border-color #c8f05a

        &[disabled]
            cursor progress
            opacity 0.8

    .gate-card-title
        font-size 24px
        font-weight 900

    .gate-card-text
        font-size 15px
        line-height 1.4
        opacity 0.85

    .gate-card-meta
        margin-top 6px
        font-size 12px
        font-weight 700
        letter-spacing 0.08em
        text-transform uppercase
        opacity 0.6

    .gate-pdf
        display inline-block
        margin-top 22px
        font-size 14px
        font-weight 700
        color #e9e6dc
        opacity 0.75

        &:hover
            opacity 1

    .gate-progress
        height 3px
        margin-top 26px
        background #2a2a24
        overflow hidden
        opacity 0
        transition opacity 0.2s

    .gate-bar
        width 35%
        height 100%
        background #ef4e35
        animation gate-slide 1.1s ease-in-out infinite

    &.is-loading .gate-progress
        opacity 1

    &.is-error .gate-card-primary .gate-card-meta::after
        content ' · failed to load, tap to retry'

@keyframes gate-slide
    0%
        transform translateX(-100%)
    100%
        transform translateX(300%)

// Tutorial
.tutorial
    position fixed
    inset 0
    z-index 60
    display flex
    align-items center
    justify-content center
    padding 20px
    background rgba(17, 17, 15, 0.72)
    font-family 'Nunito', system-ui, sans-serif

    &[hidden]
        display none

    .tutorial-card
        width 100%
        max-width 460px
        padding 26px
        background #11110f
        color #e9e6dc
        border 1px solid #34342d
        box-shadow 0 20px 60px rgba(0, 0, 0, 0.5)

        h2
            margin 0 0 16px
            font-size 26px
            font-weight 900
            color #c8f05a

    .tutorial-list
        margin 0
        padding 0
        list-style none

        li
            display grid
            grid-template-columns 110px 1fr
            gap 10px
            padding 9px 0
            border-bottom 1px solid #2a2a24
            font-size 15px

        b
            font-weight 900

    .tutorial-hint
        margin 16px 0 20px
        font-size 13px
        line-height 1.5
        opacity 0.7

    .tutorial-button
        width 100%
        padding 14px
        font inherit
        font-weight 900
        font-size 16px
        color #11110f
        background #c8f05a
        border 0
        cursor pointer

        &:focus-visible
            outline 3px solid #e9e6dc
            outline-offset 2px

    .t-touch
        display none

    html.is-mode-touch & .t-touch
        display inline

    html.is-mode-touch & .t-desk
        display none

// Minimap
.minimap
    position fixed
    left 12px
    top 12px
    z-index 8
    width 148px
    height 148px
    overflow hidden
    border-radius 50%
    border 3px solid #e9e6dc
    box-shadow 0 4px 18px rgba(0, 0, 0, 0.45)
    background #1b1b17
    pointer-events none
    display none

    html.is-started.is-gate-done:not(.input-filter-intro):not(.input-filter-menu):not(.input-filter-modal) &
        display block

    @media (max-width: 700px)
        width 104px
        height 104px
        left 8px
        top 8px

    .minimap-map
        position absolute
        left 0
        top 0
        width 600px
        height 600px
        background-size 100% 100%
        background-repeat no-repeat
        will-change transform

    .minimap-player
        position absolute
        left 50%
        top 50%
        width 0
        height 0
        margin-left -7px
        margin-top -9px
        border-left 7px solid transparent
        border-right 7px solid transparent
        border-bottom 18px solid #ef4e35
        transform-origin 7px 9px
        filter drop-shadow(0 1px 1px rgba(0, 0, 0, 0.6))
